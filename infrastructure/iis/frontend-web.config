<?xml version="1.0" encoding="UTF-8"?>
<!--
  Deployed as web.config in the IIS frontend site's physical path (the Angular `ng build`
  output directory). Requires the ARR (Application Request Routing) and URL Rewrite modules,
  with ARR's system.webServer/proxy enabled at the server level.

  Rule 1 reverse-proxies /api/* to the Spring Boot backend running locally as a Windows
  Service (see backend-service.xml.template). Rule 2 is the standard Angular client-side
  routing fallback: any request that isn't a real file/directory serves index.html.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Reverse Proxy to Sol Isla API" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:6003/api/{R:1}" />
        </rule>
        <rule name="Angular Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
